# Reproducible documentation audit for bignum-template.
PROJECT_NAME           = bignum-template
PROJECT_NUMBER         = 1.1.0
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
INPUT                  = include src benchmarks tests
FILE_PATTERNS          = *.h *.c *.asm
EXTENSION_MAPPING      = asm=C
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */dist/* */reports/* */.git/*
EXTRACT_ALL            = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
QUIET                  = NO
HAVE_DOT               = YES
FILTER_PATTERNS        = *.asm="python3 docs/doxygen_asm_filter.py"
ALIASES                += "thread_safety=Thread safety:"
ALIASES                += "complexity=Complexity:"
ALIASES                += "history=History:"
ALIASES                += "abi=ABI:"
ALIASES                += "clobbers=Clobbers:"
SORT_MEMBER_DOCS       = NO
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
